# MoonBit build artifacts
/_build/
target/
.mooncakes/

# VuePress documentation site
node_modules/
/docs/.vuepress/.cache/
/docs/.vuepress/.temp/
/gh-pages-deploy/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# CI-generated benchmark reports (regenerated during docs build).
# Sample reports and parity-artifacts are tracked; full runs and the local
# trend history are machine-specific and stay out of git.
/reports/*.json
/reports/trend/
# Large test fixtures downloaded locally (real tokenizer.json files) and the
# expected outputs generated from them. Both are regenerable (see README).
tests/data/*.full.json
tests/data/*_expected.json
tests/data/parity/

# Local-only docs (submission docs, drafts) — not version-controlled
docs/.ignore/
GOAL.md
