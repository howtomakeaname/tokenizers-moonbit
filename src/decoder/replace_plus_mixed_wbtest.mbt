// Decoder Replace per-token behavior for the anchored-plus and
// mixed-anchor families (probed 0.22.2): the regex applies within
// each token surface, then the tokens join without separator.

///|
test "decoder replace plus and mixed anchors" {
  let d = fn(p : String) -> Decoder { Decoder::Replace(pattern=p, content="#") }
  @test.assert_eq(d("\\b\\w+").decode(["hello", "world"]), "##")
  @test.assert_eq(d("\\b\\w+").decode(["zaaaaz"]), "#")
  @test.assert_eq(d("\\b\\w+").decode(["ab", "cd", "ef"]), "###")
  @test.assert_eq(d("\\b\\w+").decode(["one two", "three"]), "# ##")
  @test.assert_eq(d("\\b\\w+").decode(["aaa"]), "#")
  @test.assert_eq(d("\\b\\w+").decode(["12", "345"]), "##")
  @test.assert_eq(d("\\b\\w+").decode(["aaaa"]), "#")
  @test.assert_eq(d("\\b\\w+?").decode(["hello", "world"]), "#ello#orld")
  @test.assert_eq(d("\\b\\w+?").decode(["zaaaaz"]), "#aaaaz")
  @test.assert_eq(d("\\b\\w+?").decode(["ab", "cd", "ef"]), "#b#d#f")
  @test.assert_eq(d("\\b\\w+?").decode(["one two", "three"]), "#ne #wo#hree")
  @test.assert_eq(d("\\b\\w+?").decode(["aaa"]), "#aa")
  @test.assert_eq(d("\\b\\w+?").decode(["12", "345"]), "#2#45")
  @test.assert_eq(d("\\b\\w+?").decode(["aaaa"]), "#aaa")
  @test.assert_eq(d("\\ba{2}\\B").decode(["hello", "world"]), "helloworld")
  @test.assert_eq(d("\\ba{2}\\B").decode(["zaaaaz"]), "zaaaaz")
  @test.assert_eq(d("\\ba{2}\\B").decode(["ab", "cd", "ef"]), "abcdef")
  @test.assert_eq(d("\\ba{2}\\B").decode(["one two", "three"]), "one twothree")
  @test.assert_eq(d("\\ba{2}\\B").decode(["aaa"]), "#a")
  @test.assert_eq(d("\\ba{2}\\B").decode(["12", "345"]), "12345")
  @test.assert_eq(d("\\ba{2}\\B").decode(["aaaa"]), "#aa")
  @test.assert_eq(d("\\B\\w{2,4}\\b").decode(["hello", "world"]), "h#w#")
  @test.assert_eq(d("\\B\\w{2,4}\\b").decode(["zaaaaz"]), "za#")
  @test.assert_eq(d("\\B\\w{2,4}\\b").decode(["ab", "cd", "ef"]), "abcdef")
  @test.assert_eq(d("\\B\\w{2,4}\\b").decode(["one two", "three"]), "o# t#t#")
  @test.assert_eq(d("\\B\\w{2,4}\\b").decode(["aaa"]), "a#")
  @test.assert_eq(d("\\B\\w{2,4}\\b").decode(["12", "345"]), "123#")
  @test.assert_eq(d("\\B\\w{2,4}\\b").decode(["aaaa"]), "a#")
  @test.assert_eq(d("\\b\\w+\\B").decode(["hello", "world"]), "#o#d")
  @test.assert_eq(d("\\b\\w+\\B").decode(["zaaaaz"]), "#z")
  @test.assert_eq(d("\\b\\w+\\B").decode(["ab", "cd", "ef"]), "#b#d#f")
  @test.assert_eq(d("\\b\\w+\\B").decode(["one two", "three"]), "#e #o#e")
  @test.assert_eq(d("\\b\\w+\\B").decode(["aaa"]), "#a")
  @test.assert_eq(d("\\b\\w+\\B").decode(["12", "345"]), "#2#5")
  @test.assert_eq(d("\\b\\w+\\B").decode(["aaaa"]), "#a")
  @test.assert_eq(d("\\Ba{2}\\b").decode(["hello", "world"]), "helloworld")
  @test.assert_eq(d("\\Ba{2}\\b").decode(["zaaaaz"]), "zaaaaz")
  @test.assert_eq(d("\\Ba{2}\\b").decode(["ab", "cd", "ef"]), "abcdef")
  @test.assert_eq(d("\\Ba{2}\\b").decode(["one two", "three"]), "one twothree")
  @test.assert_eq(d("\\Ba{2}\\b").decode(["aaa"]), "a#")
  @test.assert_eq(d("\\Ba{2}\\b").decode(["12", "345"]), "12345")
  @test.assert_eq(d("\\Ba{2}\\b").decode(["aaaa"]), "aa#")
  @test.assert_eq(d("\\ba+?\\b").decode(["hello", "world"]), "helloworld")
  @test.assert_eq(d("\\ba+?\\b").decode(["zaaaaz"]), "zaaaaz")
  @test.assert_eq(d("\\ba+?\\b").decode(["ab", "cd", "ef"]), "abcdef")
  @test.assert_eq(d("\\ba+?\\b").decode(["one two", "three"]), "one twothree")
  @test.assert_eq(d("\\ba+?\\b").decode(["aaa"]), "#")
  @test.assert_eq(d("\\ba+?\\b").decode(["12", "345"]), "12345")
  @test.assert_eq(d("\\ba+?\\b").decode(["aaaa"]), "#")
  @test.assert_eq(d("\\B\\w+?").decode(["hello", "world"]), "h####w####")
  @test.assert_eq(d("\\B\\w+?").decode(["zaaaaz"]), "z#####")
  @test.assert_eq(d("\\B\\w+?").decode(["ab", "cd", "ef"]), "a#c#e#")
  @test.assert_eq(d("\\B\\w+?").decode(["one two", "three"]), "o## t##t####")
  @test.assert_eq(d("\\B\\w+?").decode(["aaa"]), "a##")
  @test.assert_eq(d("\\B\\w+?").decode(["12", "345"]), "1#3##")
  @test.assert_eq(d("\\B\\w+?").decode(["aaaa"]), "a###")
}
